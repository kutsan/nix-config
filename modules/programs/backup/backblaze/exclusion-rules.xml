<?xml version="1.0" encoding="UTF-8" ?>

<bzexclusions>
	<!-- Exclude podcasts in the iTunes Music folder -->
	<excludefname_rule
		plat="mac"
		osVers="*"
		ruleIsOptional="t"
		skipFirstCharThenStartsWith="Users/"
		contains_1="/iTunes/"
		contains_2="/iTunes/iTunes Music/Podcasts/"
		doesNotContain="*"
		endsWith="*"
		hasFileExtension="*"
	/>

	<!-- Exclude podcasts in the iTunes Media folder -->
	<excludefname_rule
		plat="mac"
		osVers="*"
		ruleIsOptional="t"
		skipFirstCharThenStartsWith="Users/"
